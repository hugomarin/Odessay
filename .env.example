# ODESSAY environment template
# Copy to .env.local and fill with real values.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# IMPORTANT: For production desktop DMG builds, override this to the hosted web runtime:
# NEXT_PUBLIC_APP_URL=https://odessay.vercel.app npm run desktop:release
# M1 additive catalog migration. Reads stay on legacy stores while enabled.
NEXT_PUBLIC_DESKTOP_CATALOG_DUAL_WRITE=true

# Supabase (use STAGING values for local development)
NEXT_PUBLIC_SUPABASE_URL=
# Preferred key name in latest Supabase docs
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
# Backward-compatible alias used in parts of Odessay docs/code
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI editor
ANTHROPIC_API_KEY=
FIREWORKS_API_KEY=
# Target for mechanical corrections (ODE-415): accounts/fireworks/models/qwen3p7-plus
FIREWORKS_MODEL=

# Workspace Agent semantic classification (OpenAI only for this vertical)
# Paste your OpenAI API key here to enable live Workspace analysis.
OPENAI_API_KEY=
# Optional overrides; the default model is gpt-5.6-luna, so only the key is required.
OPENAI_WORKSPACE_MODEL=gpt-5.6-luna
OPENAI_WORKSPACE_REASONING_EFFORT=none
OPENAI_WORKSPACE_MAX_OUTPUT_TOKENS=8192

# Product email (non-auth only)
# Supabase Auth SMTP is configured in the Supabase Dashboard with Resend SMTP.
# Do not require RESEND_API_KEY for signup, password recovery, or email changes.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Observability
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
