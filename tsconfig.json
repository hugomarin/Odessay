{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@tiptap/core": [
        "./node_modules/.pnpm/@tiptap+core@3.22.4_@tiptap+pm@3.22.4/node_modules/@tiptap/core"
      ],
      "@tiptap/html/server": [
        "./node_modules/.pnpm/@tiptap+html@3.22.4_@tiptap+core@3.22.4_@tiptap+pm@3.22.4__@tiptap+pm@3.22.4_happy-dom@20.9.0/node_modules/@tiptap/html/server"
      ],
      "@tiptap/pm/*": [
        "./node_modules/.pnpm/@tiptap+pm@3.22.4/node_modules/@tiptap/pm/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".next"
  ]
}
