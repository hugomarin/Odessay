{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Odessay",
  "version": "0.1.0",
  "identifier": "com.z9ne.odessay",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "TAURI_ENV=true npm run dev",
    "beforeBuildCommand": "node scripts/prepare-tauri-build.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Odessay",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:3000 https://odessay.vercel.app https://*.supabase.co wss://*.supabase.co; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https://asset.localhost https://*.supabase.co; media-src 'self' blob:;",
      "capabilities": ["default"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "RbKWI5ponDvo0Z6u2ZYyaisekK3Gcep+Z0d9dsW66+M=",
      "endpoints": [
        "https://api.github.com/repos/hugomarin/Odessay/releases/latest"
      ],
      "dialog": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "entitlements": "./entitlements.plist",
      "infoPlist": "./Info.plist"
    }
  }
}
