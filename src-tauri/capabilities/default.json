{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Odessay desktop. Automatic document storage uses app data; explicit user-selected files remain available through dialogs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-destroy",
    {
      "identifier": "fs:default",
      "allow": [{ "path": "$DOCUMENT/**" }]
    },
    "fs:allow-watch",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "updater:default",
    "process:allow-restart"
  ]
}
