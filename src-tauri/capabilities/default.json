{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Odessay desktop. Scope is limited to the user's Documents directory for minimal filesystem access.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    {
      "identifier": "fs:default",
      "allow": [{ "path": "$HOME/**" }]
    },
    "fs:allow-watch",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
