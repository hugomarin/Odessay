{
  "issue": "ODE-429",
  "method": "computed styles and DOM read from the running app, not eyeballed",
  "splash": {
    "tile": "64x64px",
    "tileRadius": "18px",
    "tileShadow": "rgba(35,24,15,0.22) 0px 12px 34px",
